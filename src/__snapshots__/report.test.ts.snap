exports[`report > formatJson produces structured JSON output 1`] = `
{
  "file": "/path/to/file.txt",
  "rules": [
    "/path/to/rules.json",
  ],
  "violations": {
    "document": {
      "engagement": {
        "confidence": 0.85,
        "label": "High",
        "max": 2,
        "score": 2,
      },
    },
    "lines": [
      {
        "lineNum": 1,
        "rules": [
          "banned_word",
        ],
        "text": "Empowering our users",
      },
    ],
  },
}
`;

exports[`report > formatLineReport formats flagged lines with letter keys 1`] = `
[
  "A=banned_word, B=puffery",
  "",
  "A,B             | L0001: Empowering our users",
  "A               | L0003: Another bad line",
]
