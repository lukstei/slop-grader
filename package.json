{
	"name": "@lukstei/slop-grader",
	"version": "0.2.4",
	"description": "Jev-powered, rule-based slop grader for text files",
	"license": "MIT",
	"author": "Lukas Steinbrecher",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lukstei/slop-grader.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"rules",
		"skills",
		"SKILL.md",
		"README.md"
	],
	"bin": {
		"slop-grader": "dist/slop-grader.mjs"
	},
	"scripts": {
		"build": "node esbuild.config.js",
		"typecheck": "tsc --noEmit",
		"check": "biome check --write",
		"test": "vitest run",
		"verify": "npm run typecheck && npm run check && npm run test",
		"release:patch": "node scripts/release.js patch",
		"release:minor": "node scripts/release.js minor",
		"release:major": "node scripts/release.js major"
	},
	"dependencies": {
		"@typesafe-ai/sdk": "*",
		"tokenx": "^2.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@openrouter/sdk": "^1.3.6",
		"@types/node": "^26.6.2",
		"@vitest/coverage-v8": "^5.0.1",
		"esbuild": "^0.28.2",
		"typescript": "^7.0.2",
		"vitest": "^5.0.1"
	}
}
